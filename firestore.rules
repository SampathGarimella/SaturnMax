rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function role() {
      return hasUserDoc() ? get(userPath(request.auth.uid)).data.role : null;
    }

    function isCandidate() {
      return role() == "candidate";
    }

    function isConsultant() {
      return role() == "consultant";
    }

    function isEmployee() {
      return role() == "employee" || role() == "admin";
    }

    function isAdmin() {
      return role() == "admin";
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function keepsImmutableFields() {
      return !changedKeys().hasAny(["createdAt", "createdBy"]);
    }

    function ownsOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    function optionalString(field, maxSize) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= maxSize);
    }

    function requiredString(field, maxSize) {
      return field in request.resource.data
        && request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= maxSize;
    }

    function optionalBool(field) {
      return !(field in request.resource.data) || request.resource.data[field] is bool;
    }

    function optionalNewLeadStatus(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] == "new";
    }

    function validLeadCreate() {
      return request.resource.data.keys().hasOnly([
          "id",
          "name",
          "email",
          "company",
          "subject",
          "budget_range",
          "timeline",
          "message",
          "status",
          "leadStatus",
          "source",
          "consent",
          "createdAt",
          "updatedAt"
        ])
        && optionalString("id", 160)
        && requiredString("name", 120)
        && requiredString("email", 160)
        && optionalString("company", 160)
        && optionalString("subject", 200)
        && optionalString("budget_range", 80)
        && optionalString("timeline", 80)
        && requiredString("message", 3000)
        && optionalNewLeadStatus("status")
        && optionalNewLeadStatus("leadStatus")
        && (!("source" in request.resource.data) || request.resource.data.source == "website")
        && optionalBool("consent");
    }

    function validApplicationCreate() {
      return request.resource.data.keys().hasOnly([
          "id",
          "full_name",
          "email",
          "phone",
          "current_location",
          "current_company",
          "portfolio_url",
          "resume_url",
          "primary_skills",
          "preferred_work_mode",
          "years_experience",
          "notice_period",
          "current_ctc_lpa",
          "expected_ctc_lpa",
          "introduction",
          "position_id",
          "position_title",
          "candidate_uid",
          "candidate_name",
          "status",
          "lifecycle_stage",
          "public_status",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy"
        ])
        && request.resource.data.candidate_uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status == "applied"
        && request.resource.data.lifecycle_stage == "applied"
        && requiredString("full_name", 160)
        && requiredString("email", 160)
        && requiredString("phone", 60)
        && requiredString("position_title", 220)
        && optionalString("position_id", 180)
        && optionalString("primary_skills", 2000)
        && optionalString("introduction", 5000);
    }

    function validCandidateProfileCreate(uid) {
      return (!("uid" in request.resource.data) || request.resource.data.uid == uid)
        && (!("email" in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "name",
          "phone",
          "current_location",
          "current_company",
          "portfolio_url",
          "resume_uploaded",
          "resume_url",
          "primary_skills",
          "preferred_work_mode",
          "years_experience",
          "notice_period",
          "current_ctc_lpa",
          "expected_ctc_lpa",
          "introduction",
          "role_label",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy"
        ]);
    }

    function validCandidateUserCreate(uid) {
      return request.resource.data.role == "candidate"
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          "role",
          "email",
          "name",
          "status",
          "createdAt",
          "createdBy",
          "updatedAt",
          "updatedBy"
        ]);
    }

    function safeDocumentStatus(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] in ["uploaded", "submitted", "pending_review", "requested"];
    }

    function safeReviewStatus(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] in ["pending_review", "submitted"];
    }

    function safeDocumentType(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] in [
          "resume",
          "offer_letter",
          "signed_offer",
          "signed_onboarding",
          "signed_onboarding_document",
          "onboarding_pack",
          "onboarding",
          "form12bb",
          "form_12bb",
          "pan",
          "pan_details",
          "pan_card",
          "uan",
          "uan_details",
          "epf",
          "epfo",
          "bank_details",
          "identity",
          "tax",
          "compliance",
          "account_closure_request",
          "data_removal_request",
          "other"
        ];
    }

    function validOwnerDocumentCreate() {
      return signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && safeDocumentType("type")
        && safeDocumentStatus("status")
        && safeDocumentStatus("approvalStatus");
    }

    function validOwnerReviewCreate() {
      return signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && safeDocumentType("type")
        && safeReviewStatus("status")
        && !(request.resource.data.type in ["interview_review"]);
    }

    function employeeConsultantUpdateAllowed() {
      return keepsImmutableFields()
        && changedKeys().hasOnly([
          "client",
          "clientName",
          "project",
          "role",
          "roleTitle",
          "startDate",
          "workLocation",
          "status",
          "loginEnabled",
          "loginSetupRequired",
          "credentialsStatus",
          "credentialsSentAt",
          "credentialsSentByEmployeeId",
          "credentialsPreparedAt",
          "credentialsPreparedByEmployeeId",
          "notes",
          "bankStatus",
          "panStatus",
          "uanStatus",
          "gstStatus",
          "bankReviewedAt",
          "bankReviewedBy",
          "panReviewedAt",
          "panReviewedBy",
          "uanReviewedAt",
          "uanReviewedBy",
          "updatedAt",
          "updatedBy"
        ]);
    }

    function consultantSelfUpdateAllowed() {
      return keepsImmutableFields()
        && changedKeys().hasOnly([
          "bankDetails",
          "bankStatus",
          "panDetails",
          "panStatus",
          "uanDetails",
          "uanStatus",
          "name",
          "email",
          "phone",
          "title",
          "department",
          "location",
          "bio",
          "updatedAt",
          "updatedBy"
        ])
        && (!("bankStatus" in request.resource.data) || request.resource.data.bankStatus in ["pending_review", "needs_changes"])
        && (!("panStatus" in request.resource.data) || request.resource.data.panStatus in ["pending_review", "needs_changes"])
        && (!("uanStatus" in request.resource.data) || request.resource.data.uanStatus in ["pending_review", "needs_changes"]);
    }

    function validActivityLogCreate() {
      return isEmployee()
        && request.resource.data.actorUid == request.auth.uid
        && optionalString("action", 120)
        && optionalString("outcome", 80)
        && optionalString("targetCollection", 120)
        && optionalString("targetId", 200)
        && optionalString("reason", 1000);
    }

    match /users/{uid} {
      allow read: if ownsOwner(uid) || isEmployee();
      allow create: if isAdmin()
        || (ownsOwner(uid) && validCandidateUserCreate(uid));
      allow update: if isAdmin()
        || (ownsOwner(uid)
          && request.resource.data.role == resource.data.role
          && (
            request.resource.data.status == resource.data.status
            || (!("status" in resource.data) && request.resource.data.status == "active")
          )
          && keepsImmutableFields()
          && changedKeys().hasOnly([
            "email",
            "name",
            "phone",
            "photoURL",
            "title",
            "department",
            "location",
            "bio",
            "status",
            "notificationPreferences",
            "uiPreferences",
            "updatedAt",
            "updatedBy"
          ]));
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read: if resource.data.status == "published" || isEmployee();
      allow create, update: if false;
      allow delete: if false;
    }

    match /candidates/{uid} {
      allow read: if ownsOwner(uid) || isEmployee();
      allow create: if ownsOwner(uid) && isCandidate() && validCandidateProfileCreate(uid);
      allow update: if (isEmployee()
          && keepsImmutableFields()
          && changedKeys().hasOnly([
            "workflowStage",
            "credentialsStatus",
            "credentialsSentAt",
            "credentialsSentByEmployeeId",
            "updatedAt",
            "updatedBy"
          ]))
        || (ownsOwner(uid)
          && isCandidate()
          && keepsImmutableFields()
          && changedKeys().hasOnly([
            "email",
            "name",
            "phone",
            "current_location",
            "current_company",
            "portfolio_url",
            "resume_uploaded",
            "resume_url",
            "primary_skills",
            "preferred_work_mode",
            "years_experience",
            "notice_period",
            "current_ctc_lpa",
            "expected_ctc_lpa",
            "introduction",
            "role_label",
            "updatedAt",
            "updatedBy"
          ]));
      allow delete: if false;
    }

    match /consultants/{uid} {
      allow read: if ownsOwner(uid) || isEmployee();
      allow create: if isAdmin();
      allow update: if (isAdmin() && keepsImmutableFields())
        || (isEmployee() && employeeConsultantUpdateAllowed())
        || (ownsOwner(uid) && isConsultant() && consultantSelfUpdateAllowed());
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow create: if emailVerified()
        && isCandidate()
        && validApplicationCreate();
      allow read: if isEmployee()
        || (signedIn() && resource.data.candidate_uid == request.auth.uid);
      allow update: if (isEmployee()
          && keepsImmutableFields()
          && changedKeys().hasOnly([
            "workflowStage",
            "credentialsStatus",
            "credentialsSentAt",
            "credentialsSentByEmployeeId",
            "updatedAt",
            "updatedBy"
          ]))
        || (signedIn()
          && isCandidate()
          && resource.data.candidate_uid == request.auth.uid
          && request.resource.data.candidate_uid == resource.data.candidate_uid
          && keepsImmutableFields()
          && changedKeys().hasOnly([
            "status",
            "lifecycle_stage",
            "updatedAt",
            "updatedBy"
          ])
          && request.resource.data.status in ["offer_signed", "onboarding"]);
      allow delete: if false;
    }

    match /leads/{leadId} {
      allow create: if validLeadCreate();
      allow read: if isEmployee();
      allow update: if false;
      allow delete: if false;
    }

    match /onboarding/{applicationId} {
      allow read: if isEmployee()
        || (signedIn() && resource.data.candidate_uid == request.auth.uid);
      allow create, update: if false;
      allow delete: if false;
    }

    match /documents/{documentId} {
      allow read: if isEmployee()
        || (signedIn() && resource.data.owner_uid == request.auth.uid);
      allow create: if isEmployee() || validOwnerDocumentCreate();
      allow update: if false;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if isEmployee()
        || (signedIn()
          && resource.data.owner_uid == request.auth.uid
          && !(resource.data.type in ["interview_review"]));
      allow create: if validOwnerReviewCreate();
      allow update: if false;
      allow delete: if false;
    }

    match /consultantEmailIndex/{email} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /messages/{uid}/thread/{messageId} {
      allow read: if ownsOwner(uid) || isEmployee();
      allow create: if (ownsOwner(uid)
          && request.resource.data.candidate_uid == request.auth.uid
          && request.resource.data.author == "candidate")
        || (isEmployee()
          && request.resource.data.candidate_uid == uid
          && request.resource.data.author in ["employee", "admin"]);
      allow update: if (ownsOwner(uid)
          && changedKeys().hasOnly([
            "unreadForCandidate",
            "candidateReadAt",
            "updatedAt",
            "updatedBy"
          ])
          && request.resource.data.unreadForCandidate == false)
        || (isEmployee()
          && changedKeys().hasOnly([
            "unreadForEmployee",
            "employeeReadAt",
            "updatedAt",
            "updatedBy"
          ])
          && request.resource.data.unreadForEmployee == false);
      allow delete: if false;
    }

    match /{path=**}/thread/{messageId} {
      allow read: if isEmployee();
    }

    match /loginEvents/{eventId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "role",
          "path",
          "createdAt"
        ])
        && request.resource.data.uid == request.auth.uid;
      allow read, update: if isEmployee();
      allow delete: if false;
    }

    match /activityLogs/{logId} {
      allow create: if validActivityLogCreate();
      allow read: if isEmployee();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
