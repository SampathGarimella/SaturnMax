MONGO_URL=mongodb://localhost:27017
DB_NAME=company

# Comma-separated origins for browser access
CORS_ORIGINS=http://localhost:3000,https://example.com

# Comma-separated hostnames allowed by TrustedHostMiddleware
ALLOWED_HOSTS=localhost,127.0.0.1,example.com,www.example.com

# Required for admin-only read endpoints (/api/contact and unfiltered /api/applications)
ADMIN_API_KEY=replace-with-strong-random-secret

# Optional rate limiting tune
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=12

# Email delivery (optional in local dev)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
RECIPIENT_EMAIL=careers@example.com
